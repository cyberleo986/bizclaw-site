# ─────────────────────────────────────────────
# BizClaw Agent Deploy — Environment Variables
# Copy this file to .env and fill in your keys
# ─────────────────────────────────────────────

# AI MODEL KEYS (at least one required)
# Get OpenAI key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Get Anthropic key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────
# TELEGRAM BOT (for Telegram channel)
# Create a bot: https://t.me/BotFather → /newbot → copy token
TELEGRAM_BOT_TOKEN=

# ─────────────────────────────────────────────
# EMAIL (IMAP/SMTP — for email channel)
# Works with Gmail, Outlook, or any IMAP provider
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ─────────────────────────────────────────────
# SLACK (for Slack channel)
# Create a Slack app: https://api.slack.com/apps → New App
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# ─────────────────────────────────────────────
# TWILIO (for SMS and voice channels)
# Get credentials: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─────────────────────────────────────────────
# WEB CHAT (website widget)
WEB_CHAT_ENABLED=true

# ─────────────────────────────────────────────
# AGENT CONFIGURATION
# Choose your AI model (options):
#   anthropic/claude-sonnet-4-20250514
#   anthropic/claude-haiku-4-20250414
#   openai/gpt-4o
#   openai/gpt-4o-mini
#   ollama/llama3.2 (requires local Ollama)
AGENT_MODEL=anthropic/claude-sonnet-4-20250514
AGENT_NAME=bizclaw-agent

# Timezone (affects heartbeat schedules and business hours)
# Examples: America/New_York, America/Chicago, America/Los_Angeles, Europe/London
TZ=UTC